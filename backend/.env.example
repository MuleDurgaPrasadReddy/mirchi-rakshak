APP_NAME="MirchiRakshak AI Backend"
ENVIRONMENT="development"
DEBUG=True

# Database (Supabase PostgreSQL / Direct)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# Supabase Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# AI Service (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080"
